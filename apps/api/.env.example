NODE_ENV=development
PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=tfg_user
DATABASE_PASSWORD=tfg_password
DATABASE_NAME=tfg_db

# RabbitMQ
RABBITMQ_URL=amqp://tfg_user:tfg_password@localhost:5672

# Auth
JWT_SECRET=change_me_in_production_min_32_chars
JWT_REFRESH_SECRET=change_me_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3001

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=tfg_user
S3_SECRET_KEY=tfg_password
S3_BUCKET=tfg-attachments
S3_REGION=us-east-1
