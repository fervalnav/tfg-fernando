NODE_ENV=development
PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=tfg_user
DATABASE_PASSWORD=tfg_password
DATABASE_NAME=tfg_db

# RabbitMQ
RABBITMQ_URL=amqp://tfg_user:tfg_password@localhost:5672

# AI
# Local: AI_PROVIDER=ollama + AI_BASE_URL + AI_MODEL=qwen3:8b
# PDF directo económico: AI_PROVIDER=google + AI_MODEL=gemini-3.1-flash-lite + GOOGLE_GENERATIVE_AI_API_KEY
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen3:8b
AI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_GOOGLE_THINKING_LEVEL=low
AI_STRUCTURED_OUTPUTS=true
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_RETRIES=2

# Auth
JWT_SECRET=change_me_in_production_min_32_chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=change_me_refresh_production_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:3001

# Email (MailHog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025

# Frontend URL (for invitation links)
FRONTEND_URL=http://localhost:3001

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tfg_user
S3_SECRET_ACCESS_KEY=tfg_password
S3_BUCKET=tfg-files
S3_PRESIGNED_URL_EXPIRES_IN_SECONDS=3600
