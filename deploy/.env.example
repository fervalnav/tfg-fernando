# Public endpoints. Replace both values after acquiring a domain.
APP_DOMAIN=lia.example.com
FILES_DOMAIN=files.lia.example.com
ACME_EMAIL=admin@example.com

# Images published by .github/workflows/deploy-production.yml.
API_IMAGE=ghcr.io/fervalnav/tfg-fernando-api
WEB_IMAGE=ghcr.io/fervalnav/tfg-fernando-web
MINIO_IMAGE=ghcr.io/fervalnav/tfg-fernando-minio
IMAGE_TAG=latest

# PostgreSQL. Use generated values; do not commit deploy/.env.
DATABASE_NAME=lia
DATABASE_USER=lia
DATABASE_PASSWORD=replace_with_at_least_16_random_characters

# Authentication. Generate two independent values of at least 32 characters.
JWT_SECRET=replace_with_a_random_value_of_at_least_32_characters
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=replace_with_another_random_value_of_at_least_32_characters
REFRESH_TOKEN_EXPIRES_IN=30d

# MinIO. The endpoint values are injected by Compose.
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace_with_a_non_default_access_key
S3_SECRET_ACCESS_KEY=replace_with_a_long_random_secret_key
S3_BUCKET=lia-files
S3_PRESIGNED_URL_EXPIRES_IN_SECONDS=900

# Google AI. The fake provider is rejected when NODE_ENV=production.
AI_PROVIDER=google
AI_MODEL=gemini-3.1-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=replace_with_google_api_key
AI_GOOGLE_THINKING_LEVEL=low
AI_STRUCTURED_OUTPUTS=true
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_RETRIES=2

# SMTP. Keep SMTP_IGNORE_TLS=false in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_IGNORE_TLS=false
SMTP_REQUIRE_TLS=true
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=no-reply@example.com
